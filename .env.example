# ─── Auth ────────────────────────────────────────────────────────────────────
# INITIAL password for the first admin account (the only required setting). Used
# only while the users table is empty; change it in the app at Settings → Change
# password, and from then on the stored password wins and this value is ignored.
AUTH_PASSWORD=changeme

# Email and display name for that first admin. Only consulted at first boot —
# rename the account in Settings afterwards, not here. Sign in with this address.
ADMIN_EMAIL=admin@cakecrm.local
ADMIN_NAME=Admin

# Operator recovery lever. Set this ONLY to rescue the ADMIN account when its
# password is lost: on the next start it overwrites that account's password with
# this value, re-activates it, and turns its two-factor authentication off (a
# password-only reset can't help someone who also lost their authenticator). It
# logs a loud warning. Remove it and restart again afterwards — while it is set,
# every restart re-applies it and in-app changes won't survive.
# To reset a MEMBER's password, an admin does it in Settings → Team instead.
AUTH_PASSWORD_RESET=

# Secret key for JWT signing. Left as-is, one is generated on first start and
# kept (OS keychain, else backend/data/.jwt-secret) so sessions survive a
# restart. Set a long random string to control the signing key yourself — the
# recommended production posture.
JWT_SECRET=change-me-in-production

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required). The default matches the local
# docker-compose.yml. On Railway, add a PostgreSQL service and reference its
# DATABASE_URL variable instead.
DATABASE_URL=postgresql://cakecrm:cakecrm_dev@localhost:5432/cakecrm

# ─── Encryption ──────────────────────────────────────────────────────────────
# For deployed instances: Fernet encryption key for credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local use (key stored in OS keychain automatically).
ENCRYPTION_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
# CORS origins (comma-separated). Defaults to localhost dev servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Heartbeat & Notifications (issue #6) ────────────────────────────────────
# The background heartbeat AI turn. Unset → enabled on Railway, disabled locally
# (a local `python run.py` must not spam real background AI turns). The maintenance
# tick + Web Push always run — they're keyless. Set to true/false to force.
HEARTBEAT_ENABLED=
# How often the system heartbeat AI turn may run, in minutes (the tick itself is
# every 60s; a per-tick AI turn would be ~1,440/day of token burn).
HEARTBEAT_INTERVAL_MINUTES=30

# Web Push (VAPID). Leave BOTH blank to auto-generate a keypair once and persist
# it in Postgres (private key Fernet-encrypted). Web Push requires a stable
# ENCRYPTION_KEY (above) so the persisted key stays decryptable across restarts.
# Generate manually with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact/subject for VAPID claims (a mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@cakecrm.local
